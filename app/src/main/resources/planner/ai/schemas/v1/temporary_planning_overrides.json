{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "temporary_planning_overrides_v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "suggestionType", "correlationId", "suggestions"],
  "properties": {
    "schemaVersion": {"const": 1}, "suggestionType": {"const": "temporary_planning_overrides"},
    "correlationId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "suggestions": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["suggestionId", "planId", "planVersion", "planHash", "planningInputHash", "taskIds", "overrideType", "value", "rangeStart", "rangeEnd", "expiresAt", "confidence", "rationale"],
      "properties": {
        "suggestionId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "planId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "planVersion": {"type": "integer", "minimum": 1},
        "planHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "planningInputHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "taskIds": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}},
        "overrideType": {"enum": ["duration_minutes", "context_label"]},
        "value": {},
        "rangeStart": {"type": "string", "format": "date-time", "maxLength": 64},
        "rangeEnd": {"type": "string", "format": "date-time", "maxLength": 64},
        "expiresAt": {"type": "string", "format": "date-time", "maxLength": 64},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 500}
      },
      "allOf": [
        {"if": {"properties": {"overrideType": {"const": "duration_minutes"}}}, "then": {"properties": {"value": {"type": "integer", "minimum": 5, "maximum": 480}}}, "else": {"properties": {"value": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}}}}
      ]
    }}
  }
}
