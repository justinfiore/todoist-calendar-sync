{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "deadline_risk_mitigation_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suggestionType", "correlationId", "outcome", "suggestions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "suggestionType": {"const": "deadline_risk_mitigation"},
    "correlationId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "outcome": {"enum": ["actions", "clarification"]},
    "clarification": {"type": "string", "minLength": 1, "maxLength": 500},
    "suggestions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["suggestionId", "number"],
        "properties": {
          "suggestionId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
          "number": {"type": "integer", "minimum": 1, "maximum": 100},
          "deadlineDate": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "priority": {"enum": ["P1", "P2", "P3", "P4"]}
        }
      }
    }
  }
}
